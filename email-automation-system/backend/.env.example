# Database
DATABASE_URL=postgresql://user:password@localhost:5432/email_automation

# Gmail OAuth
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/google-callback

# OpenAI API
OPENAI_API_KEY=sk-your_openai_key_here

# JWT & Security
JWT_SECRET_KEY=your_secret_key_here_change_in_production
ENCRYPTION_KEY=your_fernet_key_here_generate_with_cryptography

# Redis (optional, for job queue)
REDIS_URL=redis://localhost:6379

# Application
DEBUG=True
ENVIRONMENT=development

# Email Processing
EMAIL_FETCH_LIMIT=50
EMAIL_BATCH_SIZE=5
SCHEDULER_TIMEZONE=UTC

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Retention Policy
EMAIL_RETENTION_DAYS=90
